@unpublished{kallus2026broker,
  title={The Price of ``Free'' Advice: Measuring Agency Problems in the Insurance Broker Market},
  presentations={ASSA 2027, SEA 2026, SITE 2026, NBER Summer Institute 2026},
  author={Kallus, Margaret and Shen, Elaine},
  year={2026},
  abbr={Working Paper},
  title_note={Job Market Paper},
  selected={true},
  preview={price_of_free_advice.png},
  html={/jmp/},
  supp={/jmp-appendix/},
  supp_label={Online Appendix},
  supp_file={assets/pdf/Shen_Price_of_Free_Advice_Online_Appendix.pdf},
  disabled_preregistration={https://www.socialscienceregistry.org/trials/14329},
  disabled_preregistration_label={Pre-Registration (Audit)},
  disabled_preregistration2={https://www.socialscienceregistry.org/trials/18834},
  disabled_preregistration2_label={Pre-Registration (Survey)},
  abstract={Governments often rely on private intermediaries to help people navigate complex public programs, but the very information frictions that make advice valuable can also prevent consumers from evaluating advice quality. We study how commissions, information frictions, and competitive pressure shape agency problems in Medicare, a public health insurance program serving 70 million seniors and people with disabilities. In a large-scale audit study, we hire senior ``secret shoppers'' to make 637 calls to randomly assigned brokers. Brokers steer seniors toward higher-commission plans on 52\% of calls. Dominated recommendations carry a 29\% markup, costing seniors &#36;377 per year and over &#36;12,000 in present-value lifetime wealth. Advice is driven by incentives and information frictions: when a natural experiment eliminates broker pay, steering to the high-commission plan that does not match senior preferences falls by 47\%, but does not fall to zero. A randomly assigned treatment designed to increase perceived competition causes brokers to recommend lower-priced plans, increasing consumer surplus when plans are homogeneous, but decreasing it when plans differ in coverage. Fitting a model of broker incentives and misperceptions to the data, we find that supply-side reforms, such as equalizing commissions and capping premium markups, generate larger consumer surplus gains than changes to consumer search. The findings show that competitive pressure can shift recommendations in complex markets without aligning them with consumer interests, highlighting the importance of well-designed intermediary incentives.}
}

@unpublished{lyu2025dollars,
  title={Dollars and Sense: Self-Selection in Financial Literacy Education},
  presentations={SEA 2026, BEAM 2026, Stanford Financial Education Symposium 2026},
  author={Lyu, Junru and Shen, Elaine and Voss, Laila},
  year={2026},
  abbr={Working Paper},
  selected={true},
  preregistration={https://www.socialscienceregistry.org/trials/16395},
  abstract={Standard models of human capital investment predict that individuals self-select into education based on its expected returns, yet the individuals who stand to benefit most may face frictions that discourage investment. This paper studies this tension in financial literacy education. First, we combine evidence from a university personal finance course linked to credit panel outcomes, a student financial decision-making survey, and an online experiment to document positive selection into financial education: demand for financial education is positively correlated with baseline financial knowledge and financial strength. Second, to test whether there is selection with respect to marginal returns, we use a controlled online experiment (n = 1,045). We show that individuals systematically mispredict the returns to education; expected gains are approximately flat across baseline knowledge, while realized gains decline sharply with baseline knowledge. Finally, we experimentally vary instructional format to test whether technology-backed education can change selection patterns by reducing perceived cognitive costs. We find that AI- and video-backed education increase demand for financial education relative to traditional lecture-style instruction, but fail to change selection patterns. Our findings highlight a disconnect between educational returns and demand, suggesting that financial education interventions may fail to close knowledge gaps without addressing underlying frictions.}
}

@unpublished{kallus2025medigap,
  title={Deadpooling: Strategic Lock-In in the Medigap Market},
  presentations={ASHE 2026 (coauthor), ASSA 2026 (coauthor), ASHE 2025 (coauthor)},
  author={Kallus, Margaret and Shen, Elaine},
  year={2026},
  abbr={Working Paper},
  selected={true},
  preview={deadpooling_profit_a.png},
  html={/deadpooling/},
  abstract={This paper studies how firms use subsidiaries to circumvent regulations and profit off inattentive consumers. Linking two decades of Medicare Supplement filings to annual parent--subsidiary ownership records, we document ``deadpooling'', a novel financial practice where insurers use corporate structure to circumvent regulation and extract rents from high-risk consumers in the Medicare Supplement market. We find that 17.6\% of Medigap life-years through 2020 are spent in plans that deadpool, and each year's closures transfer an additional &#36;64.7 million from seniors to insurer profits over the following five years. This extraction is a choice rather than an accounting response to an aging beneficiary pool. Using a natural experiment in which a federal statute effectively closed some plans to new enrollment, we find that deadpooling plans with identical coverage reprice much more aggressively than plans that slowly age in place. Harm to consumers accrues through increased payments to insurers, switching costs, and the change in consumer surplus from beneficiaries priced out of the market. We estimate total harm to be &#36;108.3 million for each year's closures over the following five years and that each dollar of deadpooling markup collected by insurers costs seniors &#36;1.67. We find that expanding switching rights, an intervention that would eliminate this harm in a market with perfectly rational consumers, only reduces deadpooling by 18\%. We explain this finding as a consequence of consumer inattention using a demand-side simulation. We examine alternative solutions that do not rely on consumer attention and find that these reduce harm by up to 53\%, against a 5\% harm reduction from expanded switching rights.}
}

@unpublished{cuna2025hidden,
  title={The Hidden Curriculum},
  presentations={ESA World Meeting 2026 (coauthor), AFE 2025 (coauthor)},
  author={Cuna, Michael and Shen, Elaine},
  year={2026},
  abbr={Working Paper},
  selected={true},
  preview={hidden_curriculum.png},
  html={https://mgc-econ.github.io/website/JMP_latest.pdf?v},
  preregistration={https://www.socialscienceregistry.org/trials/16671},
  abstract={Despite expanded access to selective colleges, first-generation students often trail their peers in educational and early-career outcomes. We study one mechanism: the hidden curriculum---implicit, unwritten practices critical to educational and career success such as networking. First, we use data from over 70,000 students across 20 public universities to identify a first-generation gap in investment in hidden-curriculum actions. Second, in a field experiment at UC Berkeley, we show an information intervention increases take-up of hidden-curriculum actions by 13pp, closing roughly 77\% of the baseline gap. Finally, an online experiment with AI college advisors shows that first- and continuing-generation students exert similar information acquisition effort, but respond differently to hidden-curriculum nudges. Proactive information about returns eliminates this gap. The results highlight that asymmetric information about potential strategies and returns may prevent equal access from delivering equal opportunity and equal outcomes.}
}
