@unpublished{lyu2025dollars,
  title={Dollars and Sense: Self-Selection in Financial Literacy Education},
  author={Lyu, Junru and Shen, Elaine and Voss, Laila},
  year={2026},
  abbr={Working Paper},
  selected={true},
  preview={dollars_and_sense.png},
  preregistration={https://www.socialscienceregistry.org/trials/16395},
  abstract={A central prediction of human capital theory is that individuals with the highest marginal returns to education should be the most likely to invest in it. We document a stark violation of this prediction in financial literacy education: individuals with the lowest baseline knowledge---and thus the highest potential returns---have the lowest demand for education. Using motivating evidence from a large university personal finance course and a controlled online experiment (n=1,047), we document that demand for financial education is positively correlated with baseline financial literacy, potentially exacerbating pre-existing inequalities. In the lab setting, we identify the mechanism driving this inefficiency. Low-ability individuals systematically miscalibrate their beliefs, overestimating their baseline knowledge while underestimating the returns to education. To test whether reducing perceived cognitive costs can correct this distortion, we vary the format of the education material, comparing a traditional lecture-style education to video- and AI-based alternatives. While the AI and video versions significantly increase aggregate demand, they fail to correct the adverse selection on ability. Together, the results suggest that supply-side interventions alone may be insufficient to close financial literacy gaps without addressing underlying belief distortions.},
  additional_info={Draft available upon request.}
}

@unpublished{kallus2025medigap,
  title={Mind the Medigap: Biases, Regulations, and the Choice of Dominated Insurance Policies in the Medicare Supplement Market},
  author={Kallus, Margaret and Shen, Elaine},
  year={2026},
  abbr={Working Paper},
  selected={true},
  preview={mind_the_medigap.png},
  additional_info={Margaret's Job Market Paper. Draft available upon request.},
  abstract={Profit-maximizing firms often find ways to benefit from inattentive consumers. An example is in insurance markets, where insurers facing limited consumer mobility have an incentive to strategically cycle their risk pools by using low advertised rates to attract new business while raising rates on existing consumers. When a cohort of healthy new enrollees ages and sickens, the insurer closes the block to new entrants, continues extracting above-cost premiums from the trapped cohort, and opens a fresh block to attract the next healthy cohort. We call this practice ``deadpooling.'' This paper formalizes the mechanism as a general property of open price insurance contracts with imperfect consumer switching, then uses the Medigap market, a setting with state-level variation in switching rules, to provide the first empirical documentation of deadpooling at scale. We find that 16.7\% of Medigap life-years are spent in a plan that deadpools, resulting in an estimated &#36;293.8 million annual transfer from seniors to insurer profits, and &#36;5.6 billion over our sample period. Our mechanism test distinguishes strategic markup from passive adverse selection: within states with no switching rights, deadpooled blocks show premium growth exceeding claims growth, while non-deadpooling closures do not. A calibrated micro-simulation evaluates policies aimed at curbing this practice, finding that many demand-side interventions are not effective without a highly attentive consumer base.}
}

@unpublished{cuna2025hidden,
  title={The Hidden Curriculum},
  author={Cuna, Michael and Shen, Elaine},
  year={2026},
  abbr={Working Paper},
  selected={true},
  preview={hidden_curriculum.png},
  preregistration={https://www.socialscienceregistry.org/trials/16671},
  additional_info={Michael's Job Market Paper. Draft available upon request.},
  abstract={Despite dramatically expanded access to selective U.S. colleges, first-generation students persistently trail continuing-generation peers in GPA, internship attainment, and early-career outcomes. We identify a key mechanism: the hidden curriculum---unwritten strategies like cold-emailing alumni or strategically engaging faculty, essential for success yet unknown and costly to discover without guidance. Leveraging survey and administrative data from 100,000+ undergraduates across 20 public universities, we document stark disparities: first-generation students invest 14--26\% less in these high-return hidden actions while over-investing in formal tasks. Standard explanations---income, ability, or preferences---do not fully explain these gaps. Through a field experiment at UC Berkeley, we isolate causal channels by randomizing information on action availability (awareness) versus returns (beliefs): awareness treatments close the 30\% baseline gap almost entirely. Finally, we develop an AI college advisor to expose underlying search frictions in an online experiment; first-generation students allocate just 11\% (versus 16\%) of queries to hidden topics and follow up about 48\% less on hidden curriculum nudges. However, an ``active'' AI that increases awareness narrows these search gaps and follow-up behaviors. By formalizing the hidden curriculum as dual informational frictions, we demonstrate that overcoming these invisible barriers requires more than equal access.}
}
