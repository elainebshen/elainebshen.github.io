@unpublished{kallus2026broker,
  title={The Price of ``Free'' Advice: Measuring Agency Problems in the Insurance Broker Market},
  presentations={ASSA 2027, SEA 2026, SITE 2026, NBER Summer Institute 2026},
  author={Kallus, Margaret and Shen, Elaine},
  year={2026},
  abbr={Working Paper},
  selected={true},
  disabled_preregistration={https://www.socialscienceregistry.org/trials/14329},
  disabled_preregistration_label={Pre-Registration (Audit)},
  disabled_preregistration2={https://www.socialscienceregistry.org/trials/18834},
  disabled_preregistration2_label={Pre-Registration (Survey)},
  additional_info={Draft available upon request.},
  abstract={Intermediaries help consumers navigate complex products and services, but the same information frictions that create demand for expert advice can prevent consumers from evaluating the experts themselves. Agency problems may therefore persist even in competitive, highly regulated markets. We study this problem in the Medicare insurance broker market, a market serving almost 70 million seniors and individuals with disabilities. We conduct an audit study where we hire senior ``secret shoppers'' to make 637 calls to randomly assigned brokers. Brokers provide at least one misaligned recommendation on 52\% of calls, and dominated recommendations can cost seniors over &#36;12,000 in present-value lifetime wealth. A natural experiment eliminating broker commissions reduces steering toward a higher-commission plan by 21 percentage points, but does not eliminate it. A randomly assigned treatment designed to increase perceived competition---by signaling that seniors will seek multiple recommendations---causes brokers to recommend lower-priced plans. When plans differ in quality, however, this response can reduce consumer surplus. Using a structural model to estimate counterfactual policies, we find that supply-side reforms such as equalizing commissions and capping premium markups generate larger gains in consumer surplus than policies that can be directly implemented by seniors themselves (e.g. consumer feedback and competitive pressure). The findings highlight limitations to using consumer choice and competition to discipline markets for complex products.}
}

@unpublished{lyu2025dollars,
  title={Dollars and Sense: Self-Selection in Financial Literacy Education},
  presentations={SEA 2026, BEAM 2026, Stanford Financial Education Symposium 2026},
  author={Lyu, Junru and Shen, Elaine and Voss, Laila},
  year={2026},
  abbr={Working Paper},
  selected={true},
  preview={dollars_and_sense.png},
  preregistration={https://www.socialscienceregistry.org/trials/16395},
  abstract={A central prediction of human capital theory is that individuals with the highest marginal returns to education should be the most likely to invest in it. We document a stark violation of this prediction in financial literacy education: individuals with the lowest baseline knowledge---and thus the highest potential returns---have the lowest demand for education. Using motivating evidence from a large university personal finance course and a controlled online experiment (n=1,047), we document that demand for financial education is positively correlated with baseline financial literacy, potentially exacerbating pre-existing inequalities. In the lab setting, we identify the mechanism driving this inefficiency. Low-ability individuals systematically miscalibrate their beliefs, overestimating their baseline knowledge while underestimating the returns to education. To test whether reducing perceived cognitive costs can correct this distortion, we vary the format of the education material, comparing a traditional lecture-style education to video- and AI-based alternatives. While the AI and video versions significantly increase aggregate demand, they fail to correct the adverse selection on ability. Together, the results suggest that supply-side interventions alone may be insufficient to close financial literacy gaps without addressing underlying belief distortions.},
  additional_info={Draft available upon request.}
}

@unpublished{kallus2025medigap,
  title={Deadpooling: Strategic Adverse Selection in the Medigap Market},
  presentations={ASHE 2026 (coauthor), ASSA 2026 (coauthor), ASHE 2025 (coauthor)},
  author={Kallus, Margaret and Shen, Elaine},
  year={2026},
  abbr={Working Paper},
  selected={true},
  preview={deadpooling.png},
  html={/deadpooling/},
  additional_info={Draft available upon request.},
  abstract={This paper studies how firms use subsidiaries to circumvent regulations and profit off inattentive consumers. Linking two decades of Medicare Supplement filings to annual parent--subsidiary ownership records, we document ``deadpooling'', a novel financial practice where insurers use corporate structure to circumvent regulation and extract rents from high-risk consumers in the Medicare Supplement market. We find that 17.6\% of Medigap life-years through 2020 are spent in plans that deadpool, and each year's closures transfer an additional &#36;64.7 million from seniors to insurer profits over the following five years. This extraction is a choice rather than an accounting response to an aging beneficiary pool. Using a natural experiment in which a federal statute effectively closed some plans to new enrollment, we find that deadpooling plans with identical coverage reprice much more aggressively than plans that slowly age in place. Harm to consumers accrues through increased payments to insurers, switching costs, and the change in consumer surplus from beneficiaries priced out of the market. We estimate total harm to be &#36;129.4 million for each year's closures over the following five years and that each dollar of deadpooling markup collected by insurers costs seniors &#36;2.00. We find that expanding switching rights, an intervention that would eliminate this harm in a market with perfectly rational consumers, only reduces deadpooling by 18\%. We explain this finding as a consequence of consumer inattention using a demand-side simulation. We examine alternative solutions that do not rely on consumer attention and find that these reduce harm by up to 53\%, against a 5\% harm reduction from expanded switching rights.}
}

@unpublished{cuna2025hidden,
  title={The Hidden Curriculum},
  presentations={AFE 2025 (coauthor)},
  author={Cuna, Michael and Shen, Elaine},
  year={2026},
  abbr={Working Paper},
  selected={true},
  preview={hidden_curriculum.png},
  html={https://mgc-econ.github.io/website/JMP_latest.pdf?v},
  preregistration={https://www.socialscienceregistry.org/trials/16671},
  abstract={Despite expanded access to selective colleges, first-generation students often trail their peers in educational and early-career outcomes. We study one mechanism: the hidden curriculum---implicit, unwritten practices critical to educational and career success such as networking. First, we use data from over 70,000 students across 20 public universities to identify a first-generation gap in investment in hidden-curriculum actions. Second, in a field experiment at UC Berkeley, we show an information intervention increases take-up of hidden-curriculum actions by 13pp, closing roughly 77\% of the baseline gap. Finally, an online experiment with AI college advisors shows that first- and continuing-generation students exert similar information acquisition effort, but respond differently to hidden-curriculum nudges. Proactive information about returns eliminates this gap. The results highlight that asymmetric information about potential strategies and returns may prevent equal access from delivering equal opportunity and equal outcomes.}
}
